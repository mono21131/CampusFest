        <mxCell id="titulo" value="CdU 1 - Consultar cupos - Diagrama de comunicación" style="text;html=1;fontSize=18;fontStyle=1;align=left;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="850" height="30" as="geometry" /></mxCell>
        <mxCell id="est" value="&lt;b&gt;&amp;lt;&amp;lt;actor&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;Estudiante" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="210" width="35" height="70" as="geometry" /></mxCell>
        <mxCell id="pan" value="&lt;b&gt;&amp;lt;&amp;lt;límite&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;PantallaEventos" style="shape=umlBoundary;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="218" width="65" height="55" as="geometry" /></mxCell>
        <mxCell id="cal" value="&lt;b&gt;&amp;lt;&amp;lt;control&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;CalcularDisponibilidad" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="213" width="60" height="65" as="geometry" /></mxCell>
        <mxCell id="evt" value="&lt;b&gt;&amp;lt;&amp;lt;entidad&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;Evento" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="100" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="res" value="&lt;b&gt;&amp;lt;&amp;lt;entidad&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;Reserva" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="330" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="E0" value="1. seleccionarEvento() →&lt;br&gt;9. mostrarCuposDisponibles() ←" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="est" target="pan"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="E1" value="2. solicitarCalculoDisponibilidad() →&lt;br&gt;8. cuposDisponibles ←" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pan" target="cal"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="E2" value="3. obtenerAforoYBloqueados() →&lt;br&gt;4. aforoMaximo, cuposBloqueados ←" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cal" target="evt"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="E3" value="5. obtenerReservasVigentes() →&lt;br&gt;6. confirmadas, pendientesVigentes ←" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cal" target="res"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="E4" value="7. calcularCuposDisponibles() ↺" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cal" target="cal"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="paso_a_paso" value="&lt;b&gt;Paso a paso (Secuencia de mensajes):&lt;/b&gt;&lt;br&gt;1. Estudiante → PantallaEventos: Seleccionar el evento para consultar cupos.&lt;br&gt;2. PantallaEventos → CalcularDisponibilidad: Solicitar cálculo de disponibilidad del evento.&lt;br&gt;3. CalcularDisponibilidad → Evento: Solicitar aforo máximo y cupos bloqueados.&lt;br&gt;4. Evento → CalcularDisponibilidad: Devolver aforo máximo (120) y cupos bloqueados (5).&lt;br&gt;5. CalcularDisponibilidad → Reserva: Solicitar reservas confirmadas y pendientes vigentes.&lt;br&gt;6. Reserva → CalcularDisponibilidad: Devolver reservas confirmadas (83) y pendientes vigentes (12).&lt;br&gt;7. CalcularDisponibilidad (auto-mensaje): Calcular cupos disponibles (120 - 5 - 83 - 12 = 20).&lt;br&gt;8. CalcularDisponibilidad → PantallaEventos: Devolver el resultado del cálculo a la pantalla.&lt;br&gt;9. PantallaEventos → Estudiante: Mostrar que quedan 20 cupos disponibles.&lt;br&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="450" width="820" height="215" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
