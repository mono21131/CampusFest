  <diagram name="Página-1" id="campusfest">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titulo" value="CdU 3 - Confirmar reserva - Diagrama de comunicación" style="text;html=1;fontSize=18;fontStyle=1;align=left;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="850" height="30" as="geometry" /></mxCell>
        <mxCell id="est" value="&lt;b&gt;&amp;lt;&amp;lt;actor&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;Estudiante" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="200" width="35" height="70" as="geometry" /></mxCell>
        <mxCell id="pan" value="&lt;b&gt;&amp;lt;&amp;lt;límite&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;PantallaEventos" style="shape=umlBoundary;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="208" width="65" height="55" as="geometry" /></mxCell>
        <mxCell id="ges" value="&lt;b&gt;&amp;lt;&amp;lt;control&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;GestiónReserva" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="570" y="203" width="60" height="65" as="geometry" /></mxCell>
        <mxCell id="evt" value="&lt;b&gt;&amp;lt;&amp;lt;entidad&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;Evento" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="100" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="res" value="&lt;b&gt;&amp;lt;&amp;lt;entidad&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;Reserva" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="310" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="E0" value="1. confirmarReserva() →&lt;br&gt;8. mostrarConfirmacion() ←" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="est" target="pan"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="E1" value="2. confirmar(idReserva) →&lt;br&gt;7. reservaConfirmada ←" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pan" target="ges"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="E2" value="3. consultarEvento() →" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ges" target="evt"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="E3" value="4. verificarVigencia() →&lt;br&gt;5. pendiente (&lt; 10 min) ←&lt;br&gt;6. confirmar(Confirmada) →" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ges" target="res"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="paso_a_paso" value="&lt;b&gt;Paso a paso (Secuencia de mensajes):&lt;/b&gt;&lt;br&gt;1. Estudiante → PantallaEventos: Seleccionar reserva pendiente y solicitar confirmación.&lt;br&gt;2. PantallaEventos → GestiónReserva: Enviar solicitud confirmar(idReserva).&lt;br&gt;3. GestiónReserva → Evento: Consultar información del evento asociado.&lt;br&gt;4. GestiónReserva → Reserva: Verificar vigencia de la reserva pendiente.&lt;br&gt;5. Reserva → GestiónReserva: Confirmar que está en estado Pendiente y dentro de los 10 minutos.&lt;br&gt;6. GestiónReserva → Reserva: Cambiar estado de la reserva a Confirmada.&lt;br&gt;7. GestiónReserva → PantallaEventos: Notificar que la reserva fue confirmada exitosamente.&lt;br&gt;8. PantallaEventos → Estudiante: Mostrar mensaje de reserva confirmada.&lt;br&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="840" height="195" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
