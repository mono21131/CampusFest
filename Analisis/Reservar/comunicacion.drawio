<mxfile host="app.diagrams.net">
  <diagram name="Página-1" id="campusfest">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titulo" value="CdU 2 - Reservar - Diagrama de comunicación" style="text;html=1;fontSize=18;fontStyle=1;align=left;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="850" height="30" as="geometry" /></mxCell>
        <mxCell id="est" value="&lt;b&gt;&amp;lt;&amp;lt;actor&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;Estudiante" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="260" width="35" height="70" as="geometry" /></mxCell>
        <mxCell id="pan" value="&lt;b&gt;&amp;lt;&amp;lt;límite&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;PantallaEventos" style="shape=umlBoundary;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="268" width="65" height="55" as="geometry" /></mxCell>
        <mxCell id="ges" value="&lt;b&gt;&amp;lt;&amp;lt;control&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;GestiónReserva" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530" y="263" width="60" height="65" as="geometry" /></mxCell>
        <mxCell id="cal" value="&lt;b&gt;&amp;lt;&amp;lt;control&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;CalcularDisponibilidad" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="770" y="110" width="60" height="65" as="geometry" /></mxCell>
        <mxCell id="evt" value="&lt;b&gt;&amp;lt;&amp;lt;entidad&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;Evento" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="115" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="res" value="&lt;b&gt;&amp;lt;&amp;lt;entidad&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;Reserva" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="390" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="E0" value="1. solicitarReserva(evento) →&lt;br&gt;11. mostrarReservaPendiente() ←" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="est" target="pan"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="E1" value="2. crearReserva(idEvento) →&lt;br&gt;10. reservaPendiente (10 min) ←" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pan" target="ges"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="E2" value="3. verificarCupo(idEvento) →&lt;br&gt;8. hayCupoDisponible ←" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ges" target="cal"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="E3" value="4. obtenerAforoYBloqueados() →&lt;br&gt;5. aforoMaximo, cuposBloqueados ←" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cal" target="evt"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="E4" value="6. obtenerReservasVigentes() →&lt;br&gt;7. confirmadas, pendientesVigentes ←" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cal" target="res"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="E5" value="9. crear(estado = Pendiente) →" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ges" target="res"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="paso_a_paso" value="&lt;b&gt;Paso a paso (Secuencia de mensajes):&lt;/b&gt;&lt;br&gt;1. Estudiante → PantallaEventos: Solicitar reserva para un evento seleccionado.&lt;br&gt;2. PantallaEventos → GestiónReserva: Solicitar creación de la reserva.&lt;br&gt;3. GestiónReserva → CalcularDisponibilidad: Verificar si existen cupos disponibles.&lt;br&gt;4. CalcularDisponibilidad → Evento: Obtener aforo máximo y cupos bloqueados.&lt;br&gt;5. Evento → CalcularDisponibilidad: Devolver aforo máximo y cupos bloqueados.&lt;br&gt;6. CalcularDisponibilidad → Reserva: Obtener reservas confirmadas y pendientes vigentes.&lt;br&gt;7. Reserva → CalcularDisponibilidad: Devolver total de reservas vigentes.&lt;br&gt;8. CalcularDisponibilidad → GestiónReserva: Confirmar que hay cupo disponible.&lt;br&gt;9. GestiónReserva → Reserva: Crear nueva reserva en estado Pendiente.&lt;br&gt;10. GestiónReserva → PantallaEventos: Retornar reserva creada (10 minutos para confirmar).&lt;br&gt;11. PantallaEventos → Estudiante: Mostrar confirmación de reserva en estado Pendiente.&lt;br&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="860" height="255" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
