  <diagram name="Página-1" id="campusfest">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titulo" value="CdU 7 - Generar reporte de reservas - Diagrama de comunicación" style="text;html=1;fontSize=18;fontStyle=1;align=left;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="850" height="30" as="geometry" /></mxCell>
        <mxCell id="org" value="&lt;b&gt;&amp;lt;&amp;lt;actor&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;Organizador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="260" width="35" height="70" as="geometry" /></mxCell>
        <mxCell id="int" value="&lt;b&gt;&amp;lt;&amp;lt;límite&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;InterfazOrganizador" style="shape=umlBoundary;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="170" width="65" height="55" as="geometry" /></mxCell>
        <mxCell id="rre" value="&lt;b&gt;&amp;lt;&amp;lt;límite&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;ReporteReservas" style="shape=umlBoundary;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="360" width="65" height="55" as="geometry" /></mxCell>
        <mxCell id="ges" value="&lt;b&gt;&amp;lt;&amp;lt;control&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;GestiónReserva" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="255" width="60" height="65" as="geometry" /></mxCell>
        <mxCell id="evt" value="&lt;b&gt;&amp;lt;&amp;lt;entidad&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;Evento" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="850" y="120" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="res" value="&lt;b&gt;&amp;lt;&amp;lt;entidad&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;Reserva" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="850" y="380" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="E0" value="1. seleccionarEvento() →&lt;br&gt;10.a. mostrarMensajeExito() ←" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="org" target="int"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="E1" value="2. generarReporteReservas(evento) →&lt;br&gt;9. reporteGenerado ←" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="int" target="ges"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="E2" value="3. obtenerInformacionEvento() →&lt;br&gt;4. datosEvento ←" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ges" target="evt"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="E3" value="5. obtenerReservasEvento() →&lt;br&gt;6. listaReservas ←" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ges" target="res"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="E4" value="7. consolidarListadoReservas() ↺" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ges" target="ges"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="E5" value="8. generarReporte(datos, reservas) →" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ges" target="rre"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="E6" value="10.b. mostrarReporteReservas() →" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rre" target="org"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="paso_a_paso" value="&lt;b&gt;Paso a paso (Secuencia de mensajes):&lt;/b&gt;&lt;br&gt;1. Organizador → InterfazOrganizador: Seleccionar el evento del cual desea el reporte.&lt;br&gt;2. InterfazOrganizador → GestiónReserva: Solicitar generación del reporte de reservas del evento.&lt;br&gt;3. GestiónReserva → Evento: Solicitar información del evento.&lt;br&gt;4. Evento → GestiónReserva: Devolver datos del evento.&lt;br&gt;5. GestiónReserva → Reserva: Solicitar listado de reservas asociadas al evento.&lt;br&gt;6. Reserva → GestiónReserva: Devolver lista de reservas (con estudiante, fecha/hora y estado).&lt;br&gt;7. GestiónReserva (auto-mensaje): Consolidar y calcular listado de reservas.&lt;br&gt;8. GestiónReserva → ReporteReservas: Enviar datos consolidados para generar la salida del reporte.&lt;br&gt;9. GestiónReserva → InterfazOrganizador: Confirmar que el reporte fue generado.&lt;br&gt;10.a. InterfazOrganizador → Organizador: Mostrar notificación de operación exitosa.&lt;br&gt;10.b. ReporteReservas → Organizador: Entregar/visualizar el reporte de reservas.&lt;br&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="490" width="860" height="255" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
