        <mxCell id="pan" value="&lt;b&gt;&amp;lt;&amp;lt;límite&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;PantallaEventos" style="shape=umlBoundary;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="258" width="65" height="55" as="geometry" /></mxCell>
        <mxCell id="gas" value="&lt;b&gt;&amp;lt;&amp;lt;control&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;GestiónAsistencia" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="570" y="253" width="60" height="65" as="geometry" /></mxCell>
        <mxCell id="evt" value="&lt;b&gt;&amp;lt;&amp;lt;entidad&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;Evento" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="90" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="res" value="&lt;b&gt;&amp;lt;&amp;lt;entidad&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;Reserva" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="255" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="asi" value="&lt;b&gt;&amp;lt;&amp;lt;entidad&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;Asistencia" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="420" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="E0" value="1. presentarCodigoQR() →&lt;br&gt;8. mostrarConfirmacion() ←" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="est" target="pan"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="E1" value="2. registrarIngreso(codigoQR) →&lt;br&gt;7. ingresoRegistrado ←" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pan" target="gas"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="E2" value="3. consultarEvento() →" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gas" target="evt"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="E3" value="4. verificarReservaConfirmada() →&lt;br&gt;5. reservaConfirmada ←" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gas" target="res"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="E4" value="6. registrarIngreso(fechaHoraIngreso) →" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gas" target="asi"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="paso_a_paso" value="&lt;b&gt;Paso a paso (Secuencia de mensajes):&lt;/b&gt;&lt;br&gt;1. Estudiante → PantallaEventos: Presentar código QR para ingresar al evento.&lt;br&gt;2. PantallaEventos → GestiónAsistencia: Solicitar registro de ingreso con el código QR.&lt;br&gt;3. GestiónAsistencia → Evento: Consultar información y vigencia del evento.&lt;br&gt;4. GestiónAsistencia → Reserva: Verificar que el estudiante posea una reserva en estado Confirmada.&lt;br&gt;5. Reserva → GestiónAsistencia: Confirmar validez de la reserva.&lt;br&gt;6. GestiónAsistencia → Asistencia: Crear registro de asistencia con fecha y hora de ingreso.&lt;br&gt;7. GestiónAsistencia → PantallaEventos: Confirmar que el ingreso fue registrado.&lt;br&gt;8. PantallaEventos → Estudiante: Mostrar confirmación de asistencia en pantalla.&lt;br&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="840" height="195" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
