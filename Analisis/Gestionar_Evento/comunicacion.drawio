        <mxCell id="titulo" value="CdU 6 - Gestionar un evento - Diagrama de comunicación" style="text;html=1;fontSize=18;fontStyle=1;align=left;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="850" height="30" as="geometry" /></mxCell>
        <mxCell id="org" value="&lt;b&gt;&amp;lt;&amp;lt;actor&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;Organizador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="180" width="35" height="70" as="geometry" /></mxCell>
        <mxCell id="int" value="&lt;b&gt;&amp;lt;&amp;lt;límite&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;InterfazOrganizador" style="shape=umlBoundary;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="188" width="65" height="55" as="geometry" /></mxCell>
        <mxCell id="evt" value="&lt;b&gt;&amp;lt;&amp;lt;entidad&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;Evento" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="710" y="185" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="E0" value="1. ingresarDatosEvento() →&lt;br&gt;4. mostrarConfirmacion() ←" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="org" target="int"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="E1" value="2. actualizarTextoFechaHora() →&lt;br&gt;3. eventoActualizado ←" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="int" target="evt"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="paso_a_paso" value="&lt;b&gt;Paso a paso (Secuencia de mensajes):&lt;/b&gt;&lt;br&gt;1. Organizador → InterfazOrganizador: Seleccionar evento e ingresar nueva descripción, fecha, hora o cupos.&lt;br&gt;2. InterfazOrganizador → Evento: Actualizar directamente los atributos del evento (operación sencilla sin control intermedio).&lt;br&gt;3. Evento → InterfazOrganizador: Confirmar actualización de los datos del evento.&lt;br&gt;4. InterfazOrganizador → Organizador: Mostrar confirmación de los cambios realizados.&lt;br&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="340" width="820" height="115" as="geometry" /></mxCell>
      </root>
