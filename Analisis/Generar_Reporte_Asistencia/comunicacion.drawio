  <diagram name="Página-1" id="campusfest">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titulo" value="CdU 8 - Generar reporte de asistencia - Diagrama de comunicación" style="text;html=1;fontSize=18;fontStyle=1;align=left;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="850" height="30" as="geometry" /></mxCell>
        <mxCell id="org" value="&lt;b&gt;&amp;lt;&amp;lt;actor&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;Organizador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="260" width="35" height="70" as="geometry" /></mxCell>
        <mxCell id="int" value="&lt;b&gt;&amp;lt;&amp;lt;límite&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;InterfazOrganizador" style="shape=umlBoundary;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="170" width="65" height="55" as="geometry" /></mxCell>
        <mxCell id="ras" value="&lt;b&gt;&amp;lt;&amp;lt;límite&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;ReporteAsistencia" style="shape=umlBoundary;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="360" width="65" height="55" as="geometry" /></mxCell>
        <mxCell id="gas" value="&lt;b&gt;&amp;lt;&amp;lt;control&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;GestiónAsistencia" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="255" width="60" height="65" as="geometry" /></mxCell>
        <mxCell id="evt" value="&lt;b&gt;&amp;lt;&amp;lt;entidad&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;Evento" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="850" y="120" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="asi" value="&lt;b&gt;&amp;lt;&amp;lt;entidad&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;Asistencia" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="850" y="380" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="E0" value="1. seleccionarEvento() →&lt;br&gt;10.a. mostrarMensajeExito() ←" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="org" target="int"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="E1" value="2. generarReporteAsistencia(evento) →&lt;br&gt;9. reporteGenerado ←" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="int" target="gas"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="E2" value="3. obtenerInformacionEvento() →&lt;br&gt;4. datosEvento ←" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gas" target="evt"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="E3" value="5. obtenerIngresosEvento() →&lt;br&gt;6. listaAsistencias ←" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gas" target="asi"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="E4" value="7. consolidarListadoAsistencia() ↺" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gas" target="gas"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="E5" value="8. generarReporte(datos, asistencias) →" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gas" target="ras"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="E6" value="10.b. mostrarReporteAsistencia() →" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ras" target="org"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="paso_a_paso" value="&lt;b&gt;Paso a paso (Secuencia de mensajes):&lt;/b&gt;&lt;br&gt;1. Organizador → InterfazOrganizador: Seleccionar el evento del cual desea el reporte de asistencia.&lt;br&gt;2. InterfazOrganizador → GestiónAsistencia: Solicitar generación del reporte de asistencia.&lt;br&gt;3. GestiónAsistencia → Evento: Solicitar información del evento.&lt;br&gt;4. Evento → GestiónAsistencia: Devolver datos del evento.&lt;br&gt;5. GestiónAsistencia → Asistencia: Solicitar registros de ingreso asociados al evento.&lt;br&gt;6. Asistencia → GestiónAsistencia: Devolver lista de asistentes y fecha/hora de ingreso.&lt;br&gt;7. GestiónAsistencia (auto-mensaje): Consolidar listado de asistencia.&lt;br&gt;8. GestiónAsistencia → ReporteAsistencia: Generar el reporte de asistencia.&lt;br&gt;9. GestiónAsistencia → InterfazOrganizador: Confirmar que el reporte fue generado.&lt;br&gt;10.a. InterfazOrganizador → Organizador: Mostrar confirmación en la interfaz.&lt;br&gt;10.b. ReporteAsistencia → Organizador: Entregar/visualizar el reporte de asistencia.&lt;br&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="490" width="860" height="255" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
