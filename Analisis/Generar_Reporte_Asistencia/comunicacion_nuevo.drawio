  <diagram name="Página-1" id="campusfest_nuevo">
    <mxGraphModel dx="1250" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titulo" value="CdU 8 - Generar reporte de asistencia - Diagrama de comunicación (Versión Completa)" style="text;html=1;fontSize=18;fontStyle=1;align=left;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="850" height="30" as="geometry" /></mxCell>

        <mxCell id="org" value="&lt;b&gt;&amp;lt;&amp;lt;actor&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;Organizador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="80" y="240" width="35" height="70" as="geometry" /></mxCell>
        <mxCell id="int" value="&lt;b&gt;&amp;lt;&amp;lt;límite&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;InterfazOrganizador" style="shape=umlBoundary;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="310" y="140" width="65" height="55" as="geometry" /></mxCell>
        <mxCell id="ras" value="&lt;b&gt;&amp;lt;&amp;lt;límite&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;ReporteAsistencia" style="shape=umlBoundary;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="310" y="350" width="65" height="55" as="geometry" /></mxCell>
        <mxCell id="gas" value="&lt;b&gt;&amp;lt;&amp;lt;control&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;GestiónAsistencia" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="580" y="235" width="60" height="65" as="geometry" /></mxCell>
        <mxCell id="evt" value="&lt;b&gt;&amp;lt;&amp;lt;entidad&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;Evento" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="870" y="100" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="asi" value="&lt;b&gt;&amp;lt;&amp;lt;entidad&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;Asistencia" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="870" y="350" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="est" value="&lt;b&gt;&amp;lt;&amp;lt;entidad&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;Estudiante" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1090" y="350" width="60" height="60" as="geometry" /></mxCell>

        <mxCell id="e1" value="1. seleccionarEvento() →&lt;br&gt;11.a. &amp;quot;OK&amp;quot; (confirmación) ←" edge="1" parent="1" source="org" target="int" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="2. solicitarReporteAsistencia(evento) →&lt;br&gt;10. reporteGenerado ←" edge="1" parent="1" source="int" target="gas" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="3. solicitarInfoEvento() →&lt;br&gt;4. datosEvento ←" edge="1" parent="1" source="gas" target="evt" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="5. solicitarIngresosQR() →&lt;br&gt;6. listaAsistencia (estudiante, fechaHoraIngreso) ←" edge="1" parent="1" source="gas" target="asi" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="5.1. obtenerEstudiante() →&lt;br&gt;5.2. datosEstudiante ←" edge="1" parent="1" source="asi" target="est" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="7. consolidarListadoAsistencia() ↺" edge="1" parent="1" source="gas" target="gas" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="8. generarReporte(evento, asistencias) ←&lt;br&gt;9. reporteGenerado →" edge="1" parent="1" source="ras" target="gas" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="11.b. mostrarReporteAsistencia() ←" edge="1" parent="1" source="org" target="ras" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="pasos" value="&lt;b&gt;Paso a paso (Escenario B: Reporte de Asistencia - Pág. 9 del Taller):&lt;/b&gt;&lt;br&gt;1. Organizador → InterfazOrganizador: Selecciona el evento del cual desea consultar la asistencia.&lt;br&gt;2. InterfazOrganizador → GestiónAsistencia: Solicita el listado de ingresos registrados mediante QR válido.&lt;br&gt;3. GestiónAsistencia → Evento: Solicita la información del evento.&lt;br&gt;4. Evento → GestiónAsistencia: Devuelve los datos del evento.&lt;br&gt;5. GestiónAsistencia → Asistencia: Solicita los registros de ingreso del evento (5.1 y 5.2: Asistencia obtiene los datos del Estudiante asociado).&lt;br&gt;6. Asistencia → GestiónAsistencia: Devuelve la lista de ingresos (estudiante, evento y fecha/hora de ingreso).&lt;br&gt;7. GestiónAsistencia (auto-mensaje): Consolida el listado de asistencia.&lt;br&gt;8. GestiónAsistencia → ReporteAsistencia: Ordena generar el reporte de asistencia con las columnas requeridas.&lt;br&gt;9. ReporteAsistencia → GestiónAsistencia: Confirma &amp;quot;reporte generado&amp;quot;.&lt;br&gt;10. GestiónAsistencia → InterfazOrganizador: Notifica &amp;quot;reporte generado&amp;quot;.&lt;br&gt;11.a. InterfazOrganizador → Organizador: Muestra confirmación (&amp;quot;OK&amp;quot;).&lt;br&gt;11.b. ReporteAsistencia → Organizador: Muestra el Reporte de Asistencia." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="960" height="270" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
