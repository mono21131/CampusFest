<mxfile host="app.diagrams.net">
  <diagram name="Página-1" id="campusfest">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titulo" value="CdU 9 - Cancelar reserva (a los 10 mins de una reserva) - Diagrama de comunicación" style="text;html=1;fontSize=18;fontStyle=1;align=left;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="850" height="30" as="geometry" /></mxCell>
        <mxCell id="tmp" value="&lt;b&gt;&amp;lt;&amp;lt;actor&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;10 mins de una reserva" style="html=1;shape=mxgraph.bpmn.shape;perimeter=ellipsePerimeter;outline=standard;symbol=timer;verticalLabelPosition=bottom;verticalAlign=top;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="210" width="45" height="45" as="geometry" /></mxCell>
        <mxCell id="ges" value="&lt;b&gt;&amp;lt;&amp;lt;control&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;GestiónReserva" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="200" width="60" height="65" as="geometry" /></mxCell>
        <mxCell id="evt" value="&lt;b&gt;&amp;lt;&amp;lt;entidad&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;Evento" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="100" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="res" value="&lt;b&gt;&amp;lt;&amp;lt;entidad&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;Reserva" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="310" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="E0" value="1. pasaron 10 minutos →" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tmp" target="ges"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="E1" value="2. consultarEvento() →" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ges" target="evt"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="E2" value="3. obtenerReservasPendientes() →&lt;br&gt;4. pendientes sin confirmar ←&lt;br&gt;5. vencer(Vencida) →&lt;br&gt;6. cupo liberado ←" style="endArrow=none;html=1;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ges" target="res"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="paso_a_paso" value="&lt;b&gt;Paso a paso (Secuencia de mensajes):&lt;/b&gt;&lt;br&gt;1. Temporizador (10 mins de una reserva) → GestiónReserva: Notificar cumplimiento de 10 minutos desde la creación.&lt;br&gt;2. GestiónReserva → Evento: Consultar el evento asociado.&lt;br&gt;3. GestiónReserva → Reserva: Consultar reservas pendientes que superaron los 10 minutos.&lt;br&gt;4. Reserva → GestiónReserva: Devolver reservas pendientes sin confirmar.&lt;br&gt;5. GestiónReserva → Reserva: Cambiar estado de la reserva a Vencida.&lt;br&gt;6. Reserva → GestiónReserva: Confirmar cambio a Vencida y liberación automática del cupo.&lt;br&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="430" width="840" height="155" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
