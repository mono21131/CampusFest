        <mxCell id="TLhLbefNvz9FKqGhDcTQ-27" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;span class=&quot;&quot;&gt;&lt;b&gt;Estados y transiciones de Reserva (no confundir estado con pantalla):&lt;/b&gt;&lt;/span&gt;&lt;span class=&quot;&quot;&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span class=&quot;&quot;&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="340" x="10" y="620" as="geometry" />
        </mxCell>
        <mxCell id="TLhLbefNvz9FKqGhDcTQ-28" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;li&gt;&lt;p&gt;&lt;b&gt;Estados válidos:&lt;/b&gt; Pendiente, Confirmada y Vencida.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;b&gt;Transiciones y eventos:&lt;/b&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;p&gt;De inicio a &lt;b&gt;Pendiente&lt;/b&gt;: el evento que la produce es &quot;Solicitar reserva&quot;.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;De Pendiente a &lt;b&gt;Confirmada&lt;/b&gt;: el evento que la produce es &quot;Confirmar antes de vencer los 10 minutos&quot;.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;De Pendiente a &lt;b&gt;Vencida&lt;/b&gt;: el evento que la produce es &quot;Pasar 10 minutos sin confirmar&quot;.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;" vertex="1">
          <mxGeometry height="140" width="560" x="10" y="670" as="geometry" />
