        <mxCell id="TLhLbefNvz9FKqGhDcTQ-21" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;span class=&quot;&quot;&gt;&lt;b&gt;Nueva clase (si aplica), responsabilidad y colaboradores:&lt;/b&gt;&lt;/span&gt;&lt;span class=&quot;&quot;&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="370" x="40" y="80" as="geometry" />
        </mxCell>
        <mxCell id="TLhLbefNvz9FKqGhDcTQ-24" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;li&gt;&lt;p&gt;&lt;b&gt;Nueva clase:&lt;/b&gt; Gestión Reserva (clase control).&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Responsabilidad:&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt; Encargarse de crear la reserva dejándola en estado Pendiente, y verificar si el estudiante la confirma o si ya pasaron los 10 minutos para pasarla a Vencida.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p style=&quot;&quot;&gt;&lt;b&gt;Colaboradores:&lt;/b&gt; La clase &quot;CalcularDisponibilidad&quot; es un colaborador para saber si hay cupo antes de crearla, al igual que la entidad &quot;Reserva&quot;.&lt;/p&gt;&lt;/li&gt;" vertex="1">
          <mxGeometry height="150" width="340" x="60" y="130" as="geometry" />
        </mxCell>
        <mxCell id="TLhLbefNvz9FKqGhDcTQ-25" edge="1" parent="1" source="calculo" style="endArrow=none;html=1;rounded=0;fontSize=12;defaultLabelBackgroundColor=page;startSize=8;endSize=8;curved=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1.005;exitY=0.503;exitDx=0;exitDy=0;exitPerimeter=0;" target="evento" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
