<mxfile host="app.diagrams.net">
  <diagram name="Página-1" id="z94df5goPwqJTZveY1Mf">
    <mxGraphModel dx="1010" dy="608" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titulo" parent="1" style="text;html=1;fontSize=18;align=left;verticalAlign=middle;" value="&lt;b&gt;RETO 2 - Consultar Cupos (Diagrama de Colaboración)&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="500" x="80" y="40" as="geometry" />
        </mxCell>
        <mxCell id="justificacion" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fillColor=#f9f9f9;strokeColor=#cccccc;spacing=10;" value="&lt;b&gt;Cupos que muestra:&lt;/b&gt; 20 cupos.&lt;br&gt;&lt;b&gt;Justificación:&lt;/b&gt; Se descuentan del aforo total (120) las 83 reservas confirmadas, 12 pendientes vigentes y 5 bloqueadas, ya que el sistema ocupa estos cupos de forma definitiva o provisional. Las 7 reservas canceladas no se restan porque representan únicamente un registro histórico." vertex="1">
          <mxGeometry height="80" width="550" x="80" y="80" as="geometry" />
        </mxCell>
        <mxCell id="tabla_pasos" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;" value="&lt;table style=&quot;width:100%; border-collapse: collapse; font-family: Helvetica;&quot; border=&quot;1&quot; cellpadding=&quot;8&quot;&gt;&lt;thead&gt;&lt;tr style=&quot;background-color:#e0e0e0;&quot;&gt;&lt;th&gt;Paso&lt;/th&gt;&lt;th&gt;Acción del actor o respuesta del sistema&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td style=&quot;text-align:center;&quot;&gt;1&lt;/td&gt;&lt;td&gt;El &lt;b&gt;Estudiante&lt;/b&gt; selecciona el evento de interés en la interfaz.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:center;&quot;&gt;2&lt;/td&gt;&lt;td&gt;El &lt;b&gt;Estudiante&lt;/b&gt; solicita consultar los cupos disponibles.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:center;&quot;&gt;3&lt;/td&gt;&lt;td&gt;El &lt;b&gt;Sistema&lt;/b&gt; (clase control) recupera el aforo máximo y las reservas desde el &lt;b&gt;Evento&lt;/b&gt; (clase entidad).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:center;&quot;&gt;4&lt;/td&gt;&lt;td&gt;El &lt;b&gt;Sistema&lt;/b&gt; (clase control) calcula la disponibilidad restando los cupos confirmados, pendientes y bloqueados.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:center;&quot;&gt;5&lt;/td&gt;&lt;td&gt;El &lt;b&gt;Sistema&lt;/b&gt; (clase límite) muestra en pantalla el resultado de cupos disponibles.&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="200" width="550" x="80" y="180" as="geometry" />
        </mxCell>
        <mxCell id="actor_est" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" value="&lt;b&gt;&amp;lt;&amp;lt;actor&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;Estudiante" vertex="1">
          <mxGeometry height="60" width="30" x="80" y="480" as="geometry" />
